APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=omgcomputer
# DB_USERNAME=root
# DB_PASSWORD=
# Optional directory containing mysqldump.exe; WAMP installs are auto-detected when blank.
DB_DUMP_BINARY_PATH=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# cPanel server hostname (without scheme or port) and an API token for this account.
# Keep the token private; do not commit real values to source control.
CPANEL_HOST=
CPANEL_PORT=2083
CPANEL_USERNAME=
CPANEL_API_TOKEN=
# Domain where member mailboxes should be created.
CPANEL_EMAIL_DOMAIN=
# Mailbox quota in MB.
CPANEL_EMAIL_QUOTA=1024

BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL="${MAIL_FROM_ADDRESS}"
BACKUP_DISK=backup_local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_USER_ID=
META_INSTAGRAM_ACCESS_TOKEN=
META_PUBLIC_MEDIA_BASE_URL=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v25.0

TRACK17_API_KEY=
TRACK17_API_URL=https://api.17track.net

# CHIP Collect credentials are available in the CHIP merchant portal.
# Use a test-mode API key until the integration has been verified.
CHIP_SECRET_KEY=
CHIP_BRAND_ID=
CHIP_API_URL=https://gate.chip-in.asia/api/v1
CHIP_CURRENCY=MYR

SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URL="${APP_URL}/marketplaces/callback/shopee"
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_REDIRECT_URL="${APP_URL}/marketplaces/callback/lazada"
LAZADA_API_URL=https://api.lazada.com.my/rest
LAZADA_AUTH_URL=https://auth.lazada.com/rest

VITE_APP_NAME="${APP_NAME}"
